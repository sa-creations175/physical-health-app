+                    "value": sample.value,
+                    "sourceBundleId": sample.sourceRevision.source.bundleIdentifier,
+                    "sourceName": sample.sourceRevision.source.name
+                ]
+            }
+
+            call.resolve(["samples": result])
+        }
+
+        healthStore.execute(query)
+    }
